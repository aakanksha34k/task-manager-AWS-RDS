[Unit]
Description=Student Task Manager Flask app
After=network-online.target
Wants=network-online.target

[Service]
User=taskapp
Group=taskapp
WorkingDirectory=/opt/student-task-manager
EnvironmentFile=/etc/student-task-manager/app.env
ExecStart=/opt/student-task-manager/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
